# PUBLIC build-time values only — these ship inside the client bundle.
# NEVER put secrets here (no service_role key, no API secrets, no passwords).
# Server-side secrets live in /opt/maktabali-app/app.env on the server, not in git.
#
# Vite inlines VITE_* at BUILD time and loads this file for `npm run build`
# (mode=production), overriding .env.local. Without it, builds bake the local
# dev Supabase URL into the bundle and production renders a blank page.
# Verify any build with: npm run predeploy
VITE_SUPABASE_URL="https://api.maktabali.com"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzg0MzI3MzE3LCJleHAiOjE5NDIwMDczMTd9.fzSYf83cI68kEj8LYz20cBwsYVUI9M5gqD7mgeTpDcA"
VITE_SUPABASE_PROJECT_ID="maktabali"
